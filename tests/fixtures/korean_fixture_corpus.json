  "workspace_cases": [
    {
      "name": "unrelated_controls_do_not_suppress_korean_field_gaps",
      "files": {
        "schema.ts": "type Member = { rrn: string; diagnosis: string };\nconst passwordCipher = encrypt(password);\nauthorize(user, 'admin');\naudit_log('login');\n",
        "notes.ts": "// encrypt rrn and authorize diagnosis, then add audit_log rrn\nconst note = \"encrypt rrn authorize diagnosis audit_log rrn\";\n",
        "dead-controls.ts": "export function unused(rrn: string, diagnosis: string) {\n  encrypt(rrn);\n  authorizeField(user, rrn);\n  audit_log(rrn);\n  encrypt(diagnosis);\n  authorizeField(user, diagnosis);\n  audit_log(diagnosis);\n}\n"
      },
      "expected_all": ["KR_DATA_UNIQUE_IDENTIFIER_CONTROL_GAP", "KR_DATA_SENSITIVE_INFORMATION_CONTROL_GAP", "KR_DATA_ACCESS_LOG_EVIDENCE_MISSING"]
    },
    {
      "name": "field_correlated_controls_satisfy_korean_governance_check",
      "files": {
        "schema.ts": "type Member = { residentRegistrationNumber: string; diagnosis: string };\nconst protectedRrn = encrypt(residentRegistrationNumber);\nauthorizeField(user, 'residentRegistrationNumber');\naudit_log('residentRegistrationNumber');\nconst protectedDiagnosis = encrypt(diagnosis);\nauthorizeField(user, 'diagnosis');\naudit_log('diagnosis');\n"
      },
      "expected_absent": ["KR_DATA_UNIQUE_IDENTIFIER_CONTROL_GAP", "KR_DATA_SENSITIVE_INFORMATION_CONTROL_GAP", "KR_DATA_ACCESS_LOG_EVIDENCE_MISSING"]
    },
    {
